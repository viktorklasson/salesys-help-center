{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".netlify/functions-dist",
    "rootDir": "."
  },
  "include": [
    "netlify/functions/**/*"
  ],
  "exclude": [
    "node_modules",
    ".netlify"
  ]
}
