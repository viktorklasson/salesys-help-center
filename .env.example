# Local development (.env): MongoDB on your machine, or `docker compose up -d mongo`
DATABASE_URL=mongodb://127.0.0.1/salesys-help-center
# Production (.env.production on the server) uses the compose service name instead:
# DATABASE_URL=mongodb://mongo/salesys-help-center

# Long random string, different per environment: `openssl rand -hex 32`
PAYLOAD_SECRET=YOUR_SECRET_HERE
